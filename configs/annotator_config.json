{
    "embedder": {
        "model_name": "intfloat/multilingual-e5-base",
        "pooling_method": "mean",
        "text_prefix": "query: "
    },
    "text_processor": {
        "rm_substrings": [
        ],
        "skip_substrings": [
        ],
        "obscene_substrings": [

        ]
    },
    "boilerplate": {
        "min_docs": 5,
        "min_ratio": 0.5
    },
    "image_processor": {
        "model_name": "google/siglip2-base-patch16-naflex"
    },
    "rubric_detector": {
        "patterns": [
            "^\\W*(?:\\d{1,2}[:.]\\d{2}\\s*[–—-]*\\s*)?(?:загальнонаціональн\\w+\\s+)?хвилин\\w*\\s+мовчання",
            "^\\W*щоранку\\b[^.!?]{0,45}хвилин\\w*\\s+мовчання",
            "^\\W*вшан(?:уймо|овуємо)\\b[^.!?]{0,60}хвилин\\w*\\s+мовчання",
            "^(?=[\\s\\S]{0,250}$)[\\s\\S]*хвилин\\w*\\s+мовчання[\\s\\W]*$",

            "^\\W*(?:щоденний|ранковий|вечірній|тижневий)?\\s*дайджест\\b",
            "\\b(?:щоденний|ранковий|вечірній|тижневий)\\s+дайджест\\b",
            "\\bдайджест\\s+(?:новин|подій)\\b",
            "^\\W*добірка\\b",
            "^\\W*головне\\s+за\\s+(?:день|добу|ніч|ранок|тиждень|вихідні|\\d)",
            "^\\W*топ[\\s-]?\\d*\\s*новин",
            "^\\W*що\\s+ста(?:лося|валося)\\s+за\\s+(?:день|добу|ніч|тиждень)",
            "^\\W*коротко\\s+про\\s+головне",
            "^\\W*(?:новини|події)\\s+дня\\b",
            "^\\W*(?:ранковий|вечірній|денний)\\s+(?:огляд|випуск)\\b",

            "^(?=[\\s\\S]{0,600}$)[\\s\\S]{0,100}?\\bв\\s+останню\\s+путь\\b",
            "^\\W*прощання\\s+з\\b",
            "^(?=[\\s\\S]{0,600}$)[\\s\\S]{0,90}?\\bполіг\\s+у\\s+бою\\b",
            "^(?=[\\s\\S]{0,400}$)[\\s\\S]{0,90}?\\b(?:йому|їй)\\s+назавжди\\s+\\d+"
        ]
    },
    "lang_detector": {
        "path": "models/lid.176.bin",
        "min_probability": 0.5
    },
    "cat_detector": {
        "path": "models/multilingual_e5_base_cat_detect.joblib",
        "embedding_key": "multilingual_e5_base",
        "not_news_threshold": 0.45,
        "unknown_threshold": 0.75
    }
}
