{
    "embedder": {
        "model_name": "intfloat/multilingual-e5-base",
        "pooling_method": "mean",
        "text_prefix": "query: "
    },
    "text_processor": {
        "rm_substrings": [
        ],
        "skip_substrings": [
        ],
        "obscene_substrings": [

        ]
    },
    "boilerplate": {
        "min_docs": 5,
        "min_ratio": 0.5
    },
    "image_processor": {
        "model_name": "google/siglip2-base-patch16-naflex"
    },
    "rubric_detector": {
        "macros": {
            "not_a_strike": "(?![\\s\\S]*(?:загинул|постраждал|поранен|влучи|влучан|руйнув|пожеж))",
            "where": "\\W{0,20}(?:увага\\W{1,20}(?:[^.!?,\\n]{0,60}?\\s\\W{0,10})?|(?:\\w{1,3}\\.\\s*)?[^.!?,]{0,80}(?:[—–:-]|\\n)\\W{0,10}|(?:[^.!?,\\n]{0,60}\\.\\s*\\n\\W{0,10}){1,3})?",
            "when": "(?:\\d{1,2}[:.]\\d{2}|\\d{1,2}[.\\-/]\\d{1,2}|дня|доби|тижня|день|добу|ніч|ранок|вечір|тиждень|вихідні|сьогодні|понеділ\\w+|вівторк\\w+|серед[иу]|четверг\\w+|п\\W?ятниц\\w+|субот\\w+|неділ\\w+|\\d{1,2}\\s+(?:січня|лютого|березня|квітня|травня|червня|липня|серпня|вересня|жовтня|листопада|грудня))",
            "announced": "(?:[^.!?\\n]{0,60}?\\b(?:оголош\\w+|оголоси\\w+)\\s+)?",
            "why": "(?:\\s*(?:через|у\\s+зв'язку\\s+з|унаслідок)\\s+[^.!?\\n]{0,60})?"
        },
        "patterns": [
            "^\\W*(?:(?:щодня|щоранку|сьогодні)\\s+)?(?:об?\\s+)?(?:\\d{1,2}[:.]\\d{2}\\s*[–—-]*\\s*)?(?:загальнонаціональн\\w+\\s+)?хвилин\\w*\\s+мовчання",
            "^\\W*щоранку\\b[^.!?]{0,45}хвилин\\w*\\s+мовчання",
            "^(?=[\\s\\S]{0,250}$)[\\s\\S]*хвилин\\w*\\s+мовчання[\\s\\W]*$",
            "^\\W*(?:\\d{1,2}[:.]\\d{2}\\s*[–—-]*\\s*)?(?:щодня\\s+)?(?:об?\\s+\\d{1,2}[:.]\\d{2}\\s+)?(?:вшан(?:уймо|уйте|овуємо)|вічна\\s+пам)\\b",

            "^\\W*(?:[\\w'’-]+\\s+)?дайджест\\b",
            "^\\W*[ву]\\s+дайджесті\\b",
            "\\b(?:щоденний|ранковий|вечірній|тижневий)\\s+дайджест\\b",
            "\\bдайджест\\s+(?:новин|подій)\\b",
            "^\\W*добірка\\b",
            "^\\W*(?:\\d{1,2}\\s+|[А-ЯІЇЄҐA-Z]{2,}\\s*)?головн\\w*\\s+(?:новин\\w*\\s+)?(?:від\\s+\\S{1,20}\\s+)?(?:за|на|станом\\s+на)?\\s*%when%",
            "^[^\\n]{0,180}\\bголовне\\s+(?:станом\\s+на|за)\\s+%when%[^\\n]{0,10}(?=\\n|$)",
            "^\\W*топ[\\s-]?\\d*\\s*новин",
            "^\\W*що\\s+(?:ста(?:лося|валося)|трапи(?:лось|лося))\\s+за\\s+%when%",
            "^\\W*новини\\s+за\\s+(?:цю\\s+|минулу\\s+)?%when%",
            "^\\W*підсумки\\s+%when%",
            "^\\W*коротко\\s+про\\s+головне",
            "^\\W*(?:новини|події)\\s+дня\\b",
            "^\\W*(?:ранковий|вечірній|денний)\\s+(?:огляд|випуск)\\b",
            "^[^\\n]{0,40}\\bситуація\\s+на\\s+%when%",
            "^[^\\n]{0,30}\\bяке\\s+сьогодні\\s+свято\\b",

            "^(?=[\\s\\S]{0,600}$)[\\s\\S]{0,100}?\\bв\\s+останню\\s+путь\\b",
            "^\\W*прощання\\s+з\\b",
            "^(?=[\\s\\S]{0,600}$)[\\s\\S]{0,90}?\\bполіг\\s+у\\s+бою\\b",
            "^(?=[\\s\\S]{0,400}$)[\\s\\S]{0,90}?\\b(?:йому|їй)\\s+назавжди\\s+\\d+",

            "^%not_a_strike%%where%%announced%повітрян\\w*\\s+тривог\\w*",
            "^%not_a_strike%(?=[\\s\\S]{0,300}$)[^.!?,\\n]{0,50}?\\b(?:оголоси\\w+|оголош\\w+)\\s+(?:повітряну\\s+)?тривог\\w*",
            "^%not_a_strike%%where%відбій\\b",
            "^%not_a_strike%%where%тривог\\w*\\s+(?:в|у|на)\\s+[^.!?\\n]{0,40}?%why%[\\s\\W]*$",
            "^%not_a_strike%%where%загроза\\s+(?:застосування\\s+)?балісти\\w*",
            "^%not_a_strike%(?=[\\s\\S]{0,200}$)(?=[\\s\\S]*(?:шахед|бпла|дрон|безпілотник|ракет|ціл|\\bкаб(?:и|ів|ами)?\\b))[\\s\\S]{0,90}?\\b(?:курс\\w*|напрям\\w*|прямує|рухається|з\\s+(?:півдня|півночі|сходу|заходу|південного|північного))\\b",
            "^%not_a_strike%(?=[\\s\\S]{0,120}$)\\W*(?:каб(?:и|ів|ами)?|шахед\\w*|бпла|дрон\\w*|ракет\\w*)\\s+(?:на|у|в)\\s+",
            "^%where%(?:негайно\\s+)?(?:прямуйте|пройдіть|проходьте|рушайте)\\s+(?:в|до)\\s+укритт",
            "^%not_a_strike%%where%(?:зліт|пуск\\w*)\\s+[^.!?\\n]{0,20}(?:міг-31|ту-95|ту-160|ту-22)"
        ]
    },
    "lang_detector": {
        "path": "models/lid.176.bin",
        "min_probability": 0.5
    },
    "cat_detector": {
        "path": "models/multilingual_e5_base_cat_detect.joblib",
        "embedding_key": "multilingual_e5_base",
        "not_news_threshold": 0.45,
        "unknown_threshold": 0.75
    }
}
