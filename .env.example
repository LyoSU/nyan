# Куди і чим публікувати: канал, група обговорення і токен бота на кожен issue.
# Одна змінна з цілим JSON, бо issues — список: схема з окремих змінних мусила б
# рости разом із ним і рано чи пізно від нього відстала б. docker-entrypoint.sh
# розкладає це у configs/client_config.json при старті контейнера, і падає, якщо
# значення непридатне — решта configs/ їде в образі разом із кодом, а сюди
# попадають лише ті файли, яких не можна тримати в git.
#
# Формат — як у configs/client_config.json.example, одним рядком:
# CLIENT_CONFIG_JSON={"issues":[{"name":"main","channel_id":-1001,"discussion_id":-1002,"bot_token":"123:ABC"}]}
CLIENT_CONFIG_JSON=

# MongoDB налаштування (зовнішній сервер)
MONGO_HOST=your-mongo-server.com
MONGO_PORT=27017
MONGO_DATABASE=main
MONGO_USERNAME=your_username
MONGO_PASSWORD=your_password
MONGO_AUTH_SOURCE=admin
MONGO_READ_PREFERENCE=primary
MONGO_SSL=false
MONGO_DIRECT_CONNECTION=true

# LLM — використовується для заголовків постів, розбіжностей між джерелами
# та дайджестів. Будь-який OpenAI-сумісний шлюз: OpenRouter, LiteLLM тощо.
LLM_API_KEY=your_llm_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-5.6-luna
# Таймаут одного запиту, секунди. Демон синхронний, тож запит без таймауту
# підвішує всю стрічку.
LLM_TIMEOUT=60
# Ретраї на рівні транспорту (429, 5xx, обриви з'єднання).
LLM_MAX_RETRIES=2
# Ліміт на відповідь. Моделі з міркуванням витрачають цей бюджет на думання
# ДО першого токена відповіді, і деякі шлюзи тарифікують це як completion, не
# показуючи в reasoning_tokens: один реальний виклик з'їв ~2250 токенів на
# думання для поста на ~300. Обрізана відповідь — це не помилка, яку видно, а
# невалідний JSON, тож пост тихо відкочується до цитати одного каналу.
LLM_MAX_TOKENS=8000
# Обсяг «міркування» для коротких викликів (заголовок, розбіжності, дайджест).
# Поставте none, якщо шлюз не підтримує reasoning_effort — інакше НЯН дізнається
# про це з тексту помилки, але заплатить одним зайвим запитом на процес.
LLM_REASONING_EFFORT=low

# Краулер: як часто перечитувати канал (секунди) і пауза між проходами.
# Перечитування освіжає кількість переглядів, на якій тримається ранжування,
# тож воно потрібне — але 300 с замість щохвилинного дає вп'ятеро менше
# запитів до Telegram при тій самій свіжості стрічки.
RECRAWL_TIME=300
CRAWL_INTERVAL=60

# Канал, у який публікуємо. Від нього залежать посилання на пости в дайджесті.
PUBLISH_CHANNEL_URL=https://t.me/UAliveNews

# Окремий канал для добірок. Публічний канал можна назвати юзернеймом.
# Якщо в configs/client_config.json є issue з назвою "digest", виграє він —
# саме там мав би лежати окремий bot_token, якщо дайджест постить інший бот.
DIGEST_CHANNEL_ID=@ShortUA

# Години публікації добірок за київським часом. Фіксовані години, а не інтервал:
# добірку читач чекає в певний час дня, а не через N годин після рестарту
# контейнера. Пропущений слот не створює діри — вікно рахується від останньої
# опублікованої добірки, тож наступна просто покриє більше.
DIGEST_HOURS=8,14,18,23
# Вікно для першої добірки, коли попередніх ще не було.
DIGEST_DURATION_HOURS=8
# Менше за це — добірка не виходить, а пости чекають на наступну.
DIGEST_MIN_NEWS=5

# Застарілі назви ключа, лишені для сумісності зі старими деплоями.
# Достатньо LLM_API_KEY вище.
OPENROUTER_API_KEY=
