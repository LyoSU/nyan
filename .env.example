# MongoDB налаштування (зовнішній сервер)
MONGO_HOST=your-mongo-server.com
MONGO_PORT=27017
MONGO_DATABASE=main
MONGO_USERNAME=your_username
MONGO_PASSWORD=your_password
MONGO_AUTH_SOURCE=admin
MONGO_READ_PREFERENCE=primary
MONGO_SSL=false
MONGO_DIRECT_CONNECTION=true

# LLM — використовується для заголовків постів, розбіжностей між джерелами
# та дайджестів. Будь-який OpenAI-сумісний шлюз: OpenRouter, LiteLLM тощо.
LLM_API_KEY=your_llm_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-5.4-mini
# Таймаут одного запиту, секунди. Демон синхронний, тож запит без таймауту
# підвішує всю стрічку.
LLM_TIMEOUT=60
# Ретраї на рівні транспорту (429, 5xx, обриви з'єднання).
LLM_MAX_RETRIES=2
# Обсяг «міркування» для коротких викликів (заголовок, розбіжності, дайджест).
# Поставте none, якщо шлюз не підтримує reasoning_effort — інакше НЯН дізнається
# про це з тексту помилки, але заплатить одним зайвим запитом на процес.
LLM_REASONING_EFFORT=low

# Краулер: як часто перечитувати канал (секунди) і пауза між проходами.
# Перечитування освіжає кількість переглядів, на якій тримається ранжування,
# тож воно потрібне — але 300 с замість щохвилинного дає вп'ятеро менше
# запитів до Telegram при тій самій свіжості стрічки.
RECRAWL_TIME=300
CRAWL_INTERVAL=60

# Канал, у який публікуємо. Від нього залежать посилання на пости в дайджесті.
PUBLISH_CHANNEL_URL=https://t.me/UAliveNews

# Застарілі назви ключа, лишені для сумісності зі старими деплоями.
# Достатньо LLM_API_KEY вище.
OPENROUTER_API_KEY=
